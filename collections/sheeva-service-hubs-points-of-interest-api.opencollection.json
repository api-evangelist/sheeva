        },
        {
          "info": {
            "name": "Get Service Hubs (Deprecated)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us-apis.sheeva.ai/v2/partner-apis/serviceHubs",
            "headers": [
              {
                "name": "x-sheeva-program-code",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This request returns POIs based on geolocation and service type.\nIf successful, returns: HTTP 201 CREATED.\n"
        },
        {
          "info": {
            "name": "Get Service Hub Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us-apis.sheeva.ai/v2/partner-apis/serviceHubs/:serviceHubId",
            "headers": [
              {
                "name": "x-sheeva-program-code",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "serviceHubId",
                "value": "",
                "type": "path"
              }
            ]
