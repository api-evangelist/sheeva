          "id": "7f7f31f0-fb08-400a-85b3-d369cb76e711",
          "name": "Register Status Webhook",
          "request": {
            "name": "Register Status Webhook",
            "description": {
              "content": "This request allows registering an HTTP POST status webhook with SeevaConnect.\nIf successful, returns: HTTP 201 CREATED.\nExamples below demonstrate the json body Sheeva will call your registered webhook endpoint with:\n\nService Alert Example\nStatus Callback Example\n\nStatus:\n\n\n\nStatus\nserviceType\n\n\n\n\nLOW_FUEL_DETECTED\nFUEL\n\n\nLOW_CHARGE_DETECTED\nCHARGING\n\n\nAT_SERVICE_HUB\nFUEL, CHARGING, PARKING\n\n\nAT_SERVICE_POINT\nFUEL, CHARGING, PARKING\n\n\nSERVICE_POINT_CONFIRMED\nFUEL, CHARGING, PARKING\n\n\nSERVICE_IN_PROGRESS\nPARKING\n\n\nSERVICE_COMPLETE\nFUEL, CHARGING, PARKING\n\n\nSERVICE_CANCELLED_BY_DRIVER\nFUEL, CHARGING, PARKING\n\n\nSERVICE_ABORTED_BY_SYSTEM\nFUEL, CHARGING, PARKING\n\n\nPAYMENT_COMPLETE\nFUEL, CHARGING, PARKING\n\n\nPAYMENT_FAILED\nFUEL, CHARGING, PARKING\n\n\n\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "partner-apis",
                "webhooks",
                "status-updates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Provided by Sheeva",
                "key": "x-sheeva-program-code",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"webhookUrl\": \"https://test.denso.com\",\n  \"hmacSigningKey\": \"f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8\",\n  \"apikey\": \"af75e1f0-f472-48bb-83b2-35541dc860dd\"\n}",
